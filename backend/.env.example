PROMPTSHIELD_HMAC_KEY=replace-with-a-secure-random-key
PROMPTSHIELD_AES_KEY=replace-with-a-base64-encoded-32-byte-key
PROMPTSHIELD_JWT_SECRET=replace-with-a-secure-random-jwt-secret
PROMPTSHIELD_ADMIN_USERNAME=admin
PROMPTSHIELD_ADMIN_PASSWORD_HASH=replace-with-a-generated-argon2-password-hash
PROMPTSHIELD_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PROMPTSHIELD_RATE_LIMIT_MAX_REQUESTS=30
PROMPTSHIELD_RATE_LIMIT_WINDOW_SECONDS=60