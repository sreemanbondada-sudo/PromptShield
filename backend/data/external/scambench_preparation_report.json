{
    "dataset": "shaw/scambench-training",
    "language": "en",
    "random_seed": 42,
    "maximum_prompt_length": 5000,
    "extraction_policy": "Only user-role messages are joined. System prompts, assistant responses and reasoning traces are excluded.",
