        "validation": {
            "split": "validation",
            "eligible_safe_records": 816,
            "eligible_attack_records": 1059,
            "selected_safe_records": 500,
            "selected_attack_records": 500,
            "selected_total": 1000
        },
        "test": {
            "split": "test",
            "eligible_safe_records": 811,
            "eligible_attack_records": 1004,
            "selected_safe_records": 750,
            "selected_attack_records": 750,
            "selected_total": 1500
        }
    },
    "cross_split_duplicate_policy": "Normalized prompts selected for an earlier split are excluded from later splits."
}